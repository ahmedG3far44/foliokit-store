# Copy to server/.env.production. Never commit the completed file.
PORT=5000
NODE_ENV=production
CLIENT_URL=https://foliokit.store
PUBLIC_API_URL=https://api.foliokit.store
ACME_EMAIL=admin@foliokit.store

# MongoDB Atlas connection string. URL-encode special characters in the username or password.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/foliokit?retryWrites=true&w=majority

CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_MEDIA_URL_TTL_SECONDS=3600
R2_DOWNLOAD_URL_TTL_SECONDS=90
LOCAL_UPLOAD_DIR=local-uploads
LOCAL_MEDIA_BASE_URL=https://api.foliokit.store
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=250
MAX_THEME_ZIP_SIZE_MB=100

ADMIN_EMAIL=
ADMIN_NAME=System Admin
ADMIN_CLERK_USER_ID=

RESEND_API_KEY=
EMAIL_FROM_ACCOUNT=Foliokit Account <account@foliokit.store>
EMAIL_FROM_BILLING=Foliokit Billing <billing@foliokit.store>
EMAIL_FROM_MARKETING=Foliokit Offers <offers@foliokit.store>
EMAIL_REPLY_TO=support@foliokit.store
EMAIL_UNSUBSCRIBE_SECRET=replace_with_at_least_32_random_characters
BUSINESS_ADDRESS=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=live

PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_INTEGRATION_IDS=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_CURRENCY=EGP
